[sqruff]
dialect = clickhouse
rules = all
templater = jinja

# RF04: Allow keywords as column names
# CP03: ClickHouse functions like arrayJoin must be camelCase
exclude_rules = RF04,CP03

[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = True
ignore_comment_clauses = True

[sqruff:indentation]
indent_unit = space
tab_space_size = 4
indented_joins = True
